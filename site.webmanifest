{
  "name": "DANDYAPP - Fast, Private Tools for Developers",
  "short_name": "DANDYAPP",
  "description": "A dev toolbelt, quote builder and South African VAT-compliant invoice generator. Everything runs in your browser - nothing is uploaded.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "lang": "en-ZA",
  "dir": "ltr",
  "theme_color": "#f8fafc",
  "background_color": "#f8fafc",
  "categories": ["productivity", "utilities", "developer", "business", "finance"],
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dev Toolbelt",
      "short_name": "Toolbelt",
      "description": "JSON, JWT, Base64, hashes, UUIDs, regex, diff and more",
      "url": "/toolbelt/",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Quote Builder",
      "short_name": "Quotes",
      "description": "Build a quotation from saved line items",
      "url": "/quote/",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Invoice Generator",
      "short_name": "Invoices",
      "description": "Create a SARS-compliant tax invoice with 15% VAT",
      "url": "/invoice/",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
