{
  "id": "/",
  "name": "DANDYAPP - Free SARS-Compliant Invoice App",
  "short_name": "DANDYAPP",
  "description": "Free, private invoicing app for South African businesses. Design your own template, keep customers, record payments and print SARS-compliant 15% VAT tax invoices.",
  "lang": "en-ZA",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#f8fafc",
  "background_color": "#f8fafc",
  "categories": [
    "business",
    "finance",
    "productivity"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshots/dashboard.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard: invoiced, received, outstanding and overdue at a glance"
    },
    {
      "src": "/assets/screenshots/editor.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Invoice editor with a live A4 preview"
    },
    {
      "src": "/assets/screenshots/designer.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Drag-and-drop invoice template designer"
    },
    {
      "src": "/assets/screenshots/dashboard-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard on a phone"
    },
    {
      "src": "/assets/screenshots/editor-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Invoice editor on a phone"
    }
  ],
  "shortcuts": [
    {
      "name": "New invoice",
      "short_name": "New",
      "description": "Create a SARS-compliant tax invoice",
      "url": "/#/invoice/new",
      "icons": [
        {
          "src": "/web-app-manifest-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Invoices",
      "short_name": "Invoices",
      "description": "Stored invoices and their status",
      "url": "/#/invoices",
      "icons": [
        {
          "src": "/web-app-manifest-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Customers",
      "short_name": "Customers",
      "description": "Your customer book",
      "url": "/#/customers",
      "icons": [
        {
          "src": "/web-app-manifest-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
